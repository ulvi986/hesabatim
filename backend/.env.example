# ---------------------------------------------------------------------------
# Hesabatım backend configuration. Copy to .env and adjust.
# Never commit real secrets. Nothing in this file is sent to the browser.
# ---------------------------------------------------------------------------
ENVIRONMENT=development

# Database. SQLite works out of the box for local development (tables are created on start).
# PostgreSQL (recommended for production; run `alembic upgrade head` first):
# DATABASE_URL=postgresql+psycopg://hesabatim:password@localhost:5432/hesabatim
DATABASE_URL=sqlite:///./hesabatim_dev.db

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- Authentication -----------------------------------------------------------
# HS256 signing secret for session tokens. REQUIRED in production: 32+ random characters,
# e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=10080

# --- Uploads (CSV / XLSX import) ------------------------------------------------
MAX_UPLOAD_BYTES=5242880

# --- AI -----------------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint with tool calling (OpenAI, Azure OpenAI, OpenRouter,
# Groq, Together, vLLM, Ollama's OpenAI mode...). Leave LLM_API_KEY empty to run the assistant in the
# clearly-labelled OFFLINE mode (deterministic Azerbaijani/English parser, same tools & confirmation flow).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
AI_DAILY_MESSAGE_LIMIT=300
AI_MAX_TOOL_ITERATIONS=4

# --- Rate limiting (per process) ----------------------------------------------
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_MINUTE=20
# Shared secret for the SadakatKarti card site proxy (same value as its HESABATIM_PROXY_SECRET)
PROXY_SECRET=
# Our own Next.js frontend (same value as its FRONTEND_PROXY_SECRET): lets it pass the real client IP.
FRONTEND_PROXY_SECRET=
# Signed card-change webhooks to SadakatKarti (its HESABATIM_WEBHOOK_SECRET). Off unless both are set.
SADAKAT_WEBHOOK_URL=
SADAKAT_WEBHOOK_SECRET=

# --- Admin panel (read-only, http://localhost:3000/<ADMIN_PATH>) --------------
# Disabled unless all four are set (ADMIN_PATH: 12-80 random URL-safe characters, not containing "admin"). Store only the argon2id hash, never the password:
#   .venv\Scripts\python.exe -c "from argon2 import PasswordHasher; print(PasswordHasher().hash(input()))"
# Wrap the hash in single quotes (it contains $). The secret must be 32+ random characters.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
ADMIN_PATH=
# Only these client IPs / CIDR ranges can reach the admin API; everyone else gets 404.
ADMIN_ALLOWED_IPS=127.0.0.1,::1
ADMIN_SESSION_MINUTES=30
ADMIN_MAX_FAILURES=5
ADMIN_LOCKOUT_MINUTES=15
