# Server-only settings, read by src/proxy.ts at runtime. Never prefix secrets with NEXT_PUBLIC_.
API_BACKEND_URL=http://127.0.0.1:8000
# Secret admin URL segment (same value as the backend's ADMIN_PATH): the panel is at /<ADMIN_PATH>.
ADMIN_PATH=
# Exact client IPs that may open the admin panel (the backend re-checks, and also accepts CIDR ranges).
ADMIN_ALLOWED_IPS=127.0.0.1,::1
# Same value as the backend's FRONTEND_PROXY_SECRET.
FRONTEND_PROXY_SECRET=
# Set to true only behind Railway's edge, which sets X-Real-IP to the real client address.
TRUST_X_REAL_IP=false
